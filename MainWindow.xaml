<Window x:Class="WinTerminalTools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinTerminalTools"
        Height="800" Width="1240"
        MinHeight="680" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="{StaticResource BgDarkBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0. Barra Superior -->
            <RowDefinition Height="Auto" />
            <!-- 1. Abas de Navegação -->
            <RowDefinition Height="Auto" />
            <!-- 2. Área de Conteúdo e Console -->
            <RowDefinition Height="*" />
            <!-- 3. Barra de Status Inferior -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= 0. CABEÇALHO SUPERIOR ================= -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceDarkBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Título e Badges -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡ WinTerminalTools" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <Border Background="#252530" CornerRadius="4" Padding="6,2" Margin="10,0,12,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtVersao" Text="v?" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>
                    
                    <Border x:Name="AdminBadgeBorder" Background="#143324" BorderBrush="#10B981" BorderThickness="1" CornerRadius="12" Padding="10,3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="AdminStatusDot" Width="7" Height="7" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtAdminStatus" Text="Administrador" FontSize="11" FontWeight="SemiBold" Foreground="#6EE7B7" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Campo de Pesquisa Global Corrigido (Sem Rolagem Invisível) -->
                <Grid Grid.Column="1" HorizontalAlignment="Center" Width="460" Height="36" Margin="20,0">
                    <TextBox x:Name="TxtBuscaGlobal" 
                             TextChanged="TxtBuscaGlobal_TextChanged"
                             PreviewMouseWheel="TextBox_BloquearScrollMouse"
                             Padding="36,0,32,0"
                             VerticalContentAlignment="Center"
                             FontSize="13" />
                    <TextBlock Text="🔍" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False" />
                    <TextBlock x:Name="PlaceholderBusca" Text="Filtrar comandos (ex: ip, dns, ping, mac, winget)..." 
                               Foreground="{StaticResource TextMutedBrush}" 
                               VerticalAlignment="Center" 
                               Margin="36,0,0,0" 
                               IsHitTestVisible="False" />
                    <Button x:Name="BtnLimparBusca" Click="BtnLimparBusca_Click" 
                            Content="✕" 
                            HorizontalAlignment="Right" 
                            VerticalAlignment="Center"
                            Width="24" Height="24" 
                            Margin="0,0,6,0" 
                            Padding="0" 
                            FontSize="11" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            Foreground="{StaticResource TextMutedBrush}" 
                            Visibility="Collapsed" />
                </Grid>

                <!-- Botões de Ação Rápida -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnReiniciarAdmin" Click="BtnReiniciarAdmin_Click" Margin="0,0,10,0" Padding="12,6" FontSize="12">
                        <TextBlock Text="🛡️ Executar como Admin" />
                    </Button>
                    <Button x:Name="BtnAbrirCmd" Click="BtnAbrirCmd_Click" Padding="12,6" FontSize="12">
                        <TextBlock Text="💻 Abrir CMD" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 1. ABAS PRINCIPAIS ================= -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceDarkBrush}" Padding="20,8,20,0">
            <TabControl x:Name="MainTabControl" SelectionChanged="MainTabControl_SelectionChanged">
                <TabItem Header="🌐 Rede &amp; IP" x:Name="TabRede" />
                <TabItem Header="🚀 Instalação Rápida &amp; Winget" x:Name="TabApps" />
                <TabItem Header="📁 Arquivos &amp; Pastas" x:Name="TabPastas" />
                <TabItem Header="🛠️ Sistema &amp; Reparo" x:Name="TabSistema" />
                <TabItem Header="⭐ Favoritos &amp; Recentes" x:Name="TabFavoritos" />
            </TabControl>
        </Border>

        <!-- ================= 2. ÁREA DIVIDIDA (CONTEÚDO + CONSOLE) ================= -->
        <Grid Grid.Row="2" Margin="20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="5*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- LADO ESQUERDO: CONTEÚDO DAS ABAS -->
            <!-- Os cards de comandos fixos são gerados a partir de Core/CommandCatalog.cs (Sections + Definitions)
                 dentro dos StackPanels *Sections. Aqui ficam só os cards que dependem de algo digitado. -->
            <Grid Grid.Column="0">
                <!-- ================= ABA 1: REDE E IP ================= -->
                <ScrollViewer x:Name="PanelRede" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                    <StackPanel>
                        <StackPanel x:Name="NetworkSections" />

                        <!-- TESTE DE CONECTIVIDADE DIRETA -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="🌐 Testes de Conectividade Direta (Ping &amp; Tracert)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,10" />

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="TxtHostRede" Text="google.com" PreviewMouseWheel="TextBox_BloquearScrollMouse" Margin="0,0,10,0" Height="36" />
                                    <Button Grid.Column="1" Click="BtnPing_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Height="36">
                                        <TextBlock Text="⚡ Testar Ping" />
                                    </Button>
                                    <Button Grid.Column="2" Click="BtnTracert_Click" Height="36">
                                        <TextBlock Text="🛤️ Rastrear Rota (Tracert)" />
                                    </Button>
                                </Grid>

                                <!-- DNS e porta usam o mesmo host -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Click="BtnNslookup_Click" Height="34" Margin="0,0,8,0">
                                        <TextBlock Text="🔎 Consultar DNS (nslookup)" />
                                    </Button>
                                    <TextBlock Grid.Column="2" Text="Porta:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Grid.Column="3" x:Name="TxtPortaRede" Text="443" PreviewMouseWheel="TextBox_BloquearScrollMouse" Height="34" Margin="0,0,8,0" />
                                    <Button Grid.Column="4" Click="BtnTestarPorta_Click" Height="34">
                                        <TextBlock Text="🚪 Testar Porta" />
                                    </Button>
                                </Grid>

                                <!-- Atalhos rápidos em chips -->
                                <WrapPanel>
                                    <TextBlock Text="Sugestões rápidas:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Button Content="google.com" Click="ChipHost_Click" Tag="google.com" Padding="8,3" FontSize="11" Margin="0,0,6,0" />
                                    <Button Content="1.1.1.1 (Cloudflare)" Click="ChipHost_Click" Tag="1.1.1.1" Padding="8,3" FontSize="11" Margin="0,0,6,0" />
                                    <Button Content="8.8.8.8 (Google)" Click="ChipHost_Click" Tag="8.8.8.8" Padding="8,3" FontSize="11" Margin="0,0,6,0" />
                                    <Button Content="192.168.1.1 (Roteador)" Click="ChipHost_Click" Tag="192.168.1.1" Padding="8,3" FontSize="11" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- SENHA DE WI-FI SALVO -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="🔑 Senha de uma Rede Wi-Fi Salva" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6" />
                                <TextBlock Text="Digite o nome exato da rede (veja em &quot;Redes Wi-Fi Salvas&quot;). A senha aparece no console." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtPerfilWifi" PreviewMouseWheel="TextBox_BloquearScrollMouse" Height="34" Margin="0,0,8,0" />
                                    <Button Grid.Column="1" Click="BtnSenhaWifi_Click" Height="34" Padding="14,0">
                                        <TextBlock Text="🔑 Mostrar Senha" Foreground="{StaticResource WarningBrush}" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ================= ABA 2: WINGET / ATUALIZAÇÕES E INSTALAÇÃO ================= -->
                <ScrollViewer x:Name="PanelApps" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                    <StackPanel>
                        <StackPanel x:Name="AppsSections" />

                        <!-- PROCURAR E INSTALAR: POPULARES OU RESULTADOS DA BUSCA EM CARTÕES CLICÁVEIS -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="🔎 Procurar e Instalar Programas" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="Digite o nome e aperte Enter, ou clique num dos populares. Antes de instalar, o app pede confirmação." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtPesquisaWinget" PreviewMouseWheel="TextBox_BloquearScrollMouse" KeyDown="TxtPesquisaWinget_KeyDown"
                                             TextChanged="TxtPesquisaWinget_TextChanged" Height="34" Margin="0,0,8,0" Padding="10,0,0,0" VerticalContentAlignment="Center" />
                                    <TextBlock x:Name="PlaceholderPesquisaWinget" Text="Ex.: obs, telegram, spotify, python..." Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False" />
                                    <Button Grid.Column="1" Click="BtnBuscarWinget_Click" Style="{StaticResource PrimaryButtonStyle}" Height="34" Padding="14,0">
                                        <TextBlock Text="🔍 Buscar" />
                                    </Button>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <TextBlock x:Name="TxtResultadosTitulo" Text="⭐ Populares" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                                    <Button x:Name="BtnVerPopulares" Click="BtnVerPopulares_Click" Content="⭐ Ver populares" HorizontalAlignment="Right" Padding="10,4" FontSize="11" Visibility="Collapsed" />
                                </Grid>
                                <StackPanel x:Name="ResultadosWinget" />
                            </StackPanel>
                        </Border>

                        <!-- GERENCIAR UM APP PELO ID -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="🎯 Gerenciar um App pelo ID" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6" />
                                <TextBlock Text="O ID aparece em &quot;Programas Instalados&quot; ou na busca abaixo (ex: Git.Git, Google.Chrome)." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                <TextBox x:Name="TxtAppIdUpgrade" PreviewMouseWheel="TextBox_BloquearScrollMouse" Text="Git.Git" Height="34" Margin="0,0,0,8" />
                                <WrapPanel>
                                    <Button Click="BtnInstalarEspecifico_Click" Style="{StaticResource PrimaryButtonStyle}" Height="34" Padding="14,0" Margin="0,0,8,0">
                                        <TextBlock Text="⬇ Instalar" />
                                    </Button>
                                    <Button Click="BtnUpgradeEspecifico_Click" Height="34" Padding="14,0" Margin="0,0,8,0">
                                        <TextBlock Text="⬆ Atualizar" />
                                    </Button>
                                    <Button Click="BtnDesinstalarEspecifico_Click" Height="34" Padding="14,0">
                                        <TextBlock Text="🗑️ Desinstalar" Foreground="{StaticResource DangerTextBrush}" />
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- BACKUP DA LISTA DE PROGRAMAS -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="💾 Backup da Lista de Programas" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6" />
                                <TextBlock Text="Exporte os programas instalados para um arquivo e reinstale todos de uma vez depois de formatar." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                <UniformGrid Columns="2">
                                    <Button Click="BtnExportarApps_Click" Margin="0,0,8,0" HorizontalContentAlignment="Left" Padding="12,8">
                                        <StackPanel>
                                            <TextBlock Text="📤 Exportar Lista..." FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Text="Salva um JSON (winget export)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="BtnImportarApps_Click" HorizontalContentAlignment="Left" Padding="12,8">
                                        <StackPanel>
                                            <TextBlock Text="📥 Importar e Instalar..." FontWeight="Bold" Foreground="{StaticResource DangerTextBrush}" />
                                            <TextBlock Text="Instala tudo de um JSON (winget import)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- INSTALAÇÃO EM LOTE PÓS-FORMATAÇÃO -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="🚀 Instalação Rápida Pós-Formatação" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="Marque os programas desejados para instalar em fila com um clique." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />

                                <WrapPanel Margin="0,0,0,12">
                                    <Button Click="BtnInstalarApps_Click" Style="{StaticResource PrimaryButtonStyle}" Height="34" Padding="14,0" Margin="0,0,8,0">
                                        <TextBlock Text="🚀 Instalar Selecionados" FontWeight="Bold" />
                                    </Button>
                                    <Button Click="BtnMarcarTodos_Click" Content="Selecionar Todos" Margin="0,0,6,0" Padding="10,6" FontSize="11" />
                                    <Button Click="BtnDesmarcarTodos_Click" Content="Desmarcar Todos" Padding="10,6" FontSize="11" />
                                    <Button Click="BtnEditarListaApps_Click" Content="✏️ Editar Lista" Margin="6,0,6,0" Padding="10,6" FontSize="11" ToolTip="Abre o arquivo apps.json no Bloco de Notas" />
                                    <Button Click="BtnRecarregarListaApps_Click" Content="🔄 Recarregar" Padding="10,6" FontSize="11" />
                                </WrapPanel>

                                <!-- Grupos e caixas gerados de QuickInstallCatalog (padrão ou %APPDATA%/WinTerminalTools/apps.json) -->
                                <UniformGrid x:Name="QuickInstallGrid" Columns="3" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- ================= ABA 3: PASTAS E ARQUIVOS ================= -->
                <ScrollViewer x:Name="PanelPastas" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                    <StackPanel>
                        <!-- PASTA DIGITADA: CRIAR, LISTAR E ABRIR -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="📁 Pastas" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6" />
                                <TextBlock Text="Digite o caminho completo de uma pasta e escolha a ação." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" />

                                <TextBox x:Name="TxtCaminhoPasta" PreviewMouseWheel="TextBox_BloquearScrollMouse" Text="C:\MinhaNovaPasta" Height="36" Margin="0,0,0,10" />

                                <UniformGrid Columns="3">
                                    <Button Click="BtnCriarPasta_Click" Margin="0,0,8,0" HorizontalContentAlignment="Left" Padding="12,8">
                                        <StackPanel>
                                            <TextBlock Text="📁 Criar Pasta (mkdir)" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Text="Cria a pasta digitada" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="BtnDir_Click" Margin="0,0,8,0" HorizontalContentAlignment="Left" Padding="12,8">
                                        <StackPanel>
                                            <TextBlock Text="📄 Listar Conteúdo (dir)" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Text="Lista o que há na pasta" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="BtnAbrirExplorer_Click" HorizontalContentAlignment="Left" Padding="12,8">
                                        <StackPanel>
                                            <TextBlock Text="📂 Abrir no Explorer" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Text="Abre a pasta no Explorer" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="FilesSections" />
                    </StackPanel>
                </ScrollViewer>

                <!-- ================= ABA 4: SISTEMA E REPARO ================= -->
                <ScrollViewer x:Name="PanelSistema" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                    <StackPanel>
                        <StackPanel x:Name="SystemSections" />

                        <!-- DESLIGAR / REINICIAR COM TEMPO ESCOLHIDO -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="⏰ Desligar ou Reiniciar Programado" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6" />
                                <TextBlock Text="De 0 a 1440 minutos (24 h). Para desistir, use &quot;Cancelar Desligamento&quot; acima." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                <WrapPanel>
                                    <TextBlock Text="Daqui a" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox x:Name="TxtMinutosEnergia" Text="60" Width="70" Height="34" PreviewMouseWheel="TextBox_BloquearScrollMouse" />
                                    <TextBlock Text="minutos:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="6,0,10,0" />
                                    <Button Click="BtnDesligarProgramado_Click" Height="34" Padding="14,0" Margin="0,0,8,0">
                                        <TextBlock Text="⏻ Desligar" Foreground="{StaticResource DangerTextBrush}" />
                                    </Button>
                                    <Button Click="BtnReiniciarProgramado_Click" Height="34" Padding="14,0">
                                        <TextBlock Text="🔁 Reiniciar" Foreground="{StaticResource DangerTextBrush}" />
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ================= ABA 5: FAVORITOS E RECENTES ================= -->
                <ScrollViewer x:Name="PanelFavoritos" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="⭐ Favoritos" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6" />
                                <TextBlock x:Name="TxtSemFavoritos" Text="Clique com o botão direito em qualquer comando das outras abas e escolha &quot;Adicionar aos Favoritos&quot;." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <UniformGrid x:Name="FavoritosGrid" Columns="2" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="🕘 Executados Recentemente" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                    <Button Click="BtnLimparHistorico_Click" Content="Limpar histórico" HorizontalAlignment="Right" Padding="10,4" FontSize="11" />
                                </Grid>
                                <TextBlock x:Name="TxtSemHistorico" Text="Nenhum comando executado ainda." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />
                                <StackPanel x:Name="HistoricoLista" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="⌨️ Atalhos de Teclado" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8" />
                                <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="20">
                                    <Run Text="Ctrl+F" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" /><Run Text="  buscar comandos" /><LineBreak />
                                    <Run Text="Esc" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" /><Run Text="  cancelar o comando em execução (ou limpar a busca)" /><LineBreak />
                                    <Run Text="Ctrl+L" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" /><Run Text="  limpar o console" /><LineBreak />
                                    <Run Text="Ctrl+S" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" /><Run Text="  salvar a saída do console" /><LineBreak />
                                    <Run Text="Ctrl+1 … Ctrl+5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" /><Run Text="  trocar de aba" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- SEPARADOR VISUAL -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="{StaticResource BorderDarkBrush}" />

            <!-- LADO DIREITO: TERMINAL / CONSOLE AO VIVO -->
            <Border Grid.Column="2" Background="{StaticResource ConsoleBgBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Topo do Console -->
                    <Border Grid.Row="0" Background="#16161A" CornerRadius="8,8,0,0" Padding="12,10" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="ConsoleStatusDot" Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="TxtConsoleStatus" Text="Console do Windows (Pronto)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Click="BtnCopiarConsole_Click" Padding="8,4" FontSize="11" Margin="0,0,6,0" ToolTip="Copiar toda a saída">
                                    <TextBlock Text="📋 Copiar" />
                                </Button>
                                <Button x:Name="BtnQuebraLinhas" Click="BtnQuebraLinhas_Click" Padding="8,4" FontSize="11" Margin="0,0,6,0"
                                        ToolTip="Ligado: linhas longas quebram. Desligado: tabelas (netstat, tasklist...) ficam alinhadas, com rolagem para o lado.">
                                    <TextBlock x:Name="TxtQuebraLinhas" Text="↩ Quebrar: sim" />
                                </Button>
                                <Button Click="BtnSalvarConsole_Click" Padding="8,4" FontSize="11" Margin="0,0,6,0" ToolTip="Salvar a saída num arquivo .txt (Ctrl+S)">
                                    <TextBlock Text="💾 Salvar" />
                                </Button>
                                <Button Click="BtnLimparConsole_Click" Padding="8,4" FontSize="11" ToolTip="Limpar o console (Ctrl+L)">
                                    <TextBlock Text="🧹 Limpar" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Caixa do Terminal com Rolagem Estilizada -->
                    <TextBox x:Name="TxtConsoleOutput" 
                             Grid.Row="1"
                             Style="{StaticResource ConsoleTextBoxStyle}" />

                    <!-- Barra de Ações do Console -->
                    <Border Grid.Row="2" Background="#16161A" CornerRadius="0,0,8,8" Padding="12,8" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,1,0,0">
                        <Grid>
                            <TextBlock x:Name="TxtComandoAtual" Text="Nenhum comando em execução." FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                            <Button x:Name="BtnPararComando" Click="BtnPararComando_Click" Style="{StaticResource DangerButtonStyle}" HorizontalAlignment="Right" Padding="12,5" FontSize="11" IsEnabled="False">
                                <TextBlock Text="⏹ Cancelar Execução" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= 3. BARRA INFERIOR DE STATUS ================= -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceDarkBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,1,0,0" Padding="20,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Desenvolvido por " FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                <TextBlock FontSize="11" VerticalAlignment="Center">
                    <Hyperlink NavigateUri="https://www.jeanbraga.dev/" RequestNavigate="Hyperlink_RequestNavigate" Foreground="{StaticResource AccentBrush}" TextDecorations="None" Cursor="Hand">
                        <Run Text="Jean Braga" FontWeight="Bold" />
                    </Hyperlink>
                </TextBlock>
                <TextBlock FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0">
                    <Hyperlink NavigateUri="https://www.jeanbraga.dev/" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#6EE7B7" TextDecorations="None" Cursor="Hand">
                        <Run Text="https://www.jeanbraga.dev/ ↗" FontSize="11" />
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
