<Window x:Class="WinTerminalTools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinTerminalTools v1.0"
        Height="800" Width="1240"
        MinHeight="680" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0. Barra Superior -->
            <RowDefinition Height="Auto" />
            <!-- 1. Abas de Navegação -->
            <RowDefinition Height="Auto" />
            <!-- 2. Área de Conteúdo e Console -->
            <RowDefinition Height="*" />
            <!-- 3. Barra de Status Inferior -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= 0. CABEÇALHO SUPERIOR ================= -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceDarkBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Título e Badges -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡ WinTerminalTools" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <Border Background="#252530" CornerRadius="4" Padding="6,2" Margin="10,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="v1.0" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>
                    
                    <Border x:Name="AdminBadgeBorder" Background="#143324" BorderBrush="#10B981" BorderThickness="1" CornerRadius="12" Padding="10,3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="AdminStatusDot" Width="7" Height="7" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtAdminStatus" Text="Administrador" FontSize="11" FontWeight="SemiBold" Foreground="#6EE7B7" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Campo de Pesquisa Global Corrigido (Sem Rolagem Invisível) -->
                <Grid Grid.Column="1" HorizontalAlignment="Center" Width="460" Height="36" Margin="20,0">
                    <TextBox x:Name="TxtBuscaGlobal" 
                             TextChanged="TxtBuscaGlobal_TextChanged"
                             PreviewMouseWheel="TextBox_BloquearScrollMouse"
                             Padding="36,0,32,0"
                             VerticalContentAlignment="Center"
                             FontSize="13" />
                    <TextBlock Text="🔍" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False" />
                    <TextBlock x:Name="PlaceholderBusca" Text="Filtrar comandos (ex: ip, dns, ping, mac, winget)..." 
                               Foreground="{StaticResource TextMutedBrush}" 
                               VerticalAlignment="Center" 
                               Margin="36,0,0,0" 
                               IsHitTestVisible="False" />
                    <Button x:Name="BtnLimparBusca" Click="BtnLimparBusca_Click" 
                            Content="✕" 
                            HorizontalAlignment="Right" 
                            VerticalAlignment="Center"
                            Width="24" Height="24" 
                            Margin="0,0,6,0" 
                            Padding="0" 
                            FontSize="11" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            Foreground="{StaticResource TextMutedBrush}" 
                            Visibility="Collapsed" />
                </Grid>

                <!-- Botões de Ação Rápida -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnReiniciarAdmin" Click="BtnReiniciarAdmin_Click" Margin="0,0,10,0" Padding="12,6" FontSize="12">
                        <TextBlock Text="🛡️ Executar como Admin" />
                    </Button>
                    <Button x:Name="BtnAbrirCmd" Click="BtnAbrirCmd_Click" Padding="12,6" FontSize="12">
                        <TextBlock Text="💻 Abrir CMD" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 1. ABAS PRINCIPAIS ================= -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceDarkBrush}" Padding="20,8,20,0">
            <TabControl x:Name="MainTabControl" SelectionChanged="MainTabControl_SelectionChanged">
                <TabItem Header="🌐 Rede &amp; IP" x:Name="TabRede" />
                <TabItem Header="🚀 Instalação Rápida &amp; Winget" x:Name="TabApps" />
                <TabItem Header="📁 Arquivos &amp; Pastas" x:Name="TabPastas" />
                <TabItem Header="🛠️ Sistema &amp; Reparo" x:Name="TabSistema" />
            </TabControl>
        </Border>

        <!-- ================= 2. ÁREA DIVIDIDA (CONTEÚDO + CONSOLE) ================= -->
        <Grid Grid.Row="2" Margin="20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="5*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- LADO ESQUERDO: CONTEÚDO DAS ABAS -->
            <Grid Grid.Column="0">
                <!-- ================= ABA 1: REDE E IP ================= -->
                <ScrollViewer x:Name="PanelRede" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                    <StackPanel>
                        <!-- CARD 1: DIAGNÓSTICO E MANUTENÇÃO (2 COLUNAS LIMPAS) -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- COLUNA 1: CONSULTAS E DIAGNÓSTICO (LEITURA SEGURA) -->
                            <Border Grid.Column="0" Background="{StaticResource SurfaceDarkBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="📊 Consultas de Rede" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12" />

                                    <Button Click="BtnComando_Click" Tag="ipconfig" Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="12,8">
                                        <StackPanel>
                                            <TextBlock Text="📋 Meu Endereço IP (ipconfig)" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Text="Exibe adaptadores ativos e IPs básicos" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <Button Click="BtnComando_Click" Tag="ipconfig /all" Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="12,8">
                                        <StackPanel>
                                            <TextBlock Text="🔍 Diagnóstico Completo (/all)" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Text="DHCP, DNS, máscara de rede e leases" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <Button Click="BtnComando_Click" Tag="getmac /v" Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="12,8">
                                        <StackPanel>
                                            <TextBlock Text="🏷️ Endereços Físicos MAC (getmac /v)" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Text="Lista placas e endereços físicos (MAC)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <Button Click="BtnComando_Click" Tag="arp -a" Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="12,8">
                                        <StackPanel>
                                            <TextBlock Text="🌐 Dispositivos na Rede Local (arp -a)" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Text="Tabela com IPs e MACs da rede local" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <Button Click="BtnComando_Click" Tag="netstat -ano" Margin="0,0,0,0" HorizontalContentAlignment="Left" Padding="12,8">
                                        <StackPanel>
                                            <TextBlock Text="🔌 Conexões e Portas (netstat -ano)" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Text="Portas TCP/UDP abertas e PIDs ativos" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- COLUNA 2: MANUTENÇÃO E REPARO DE DNS/IP -->
                            <Border Grid.Column="2" Background="{StaticResource SurfaceDarkBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="🛠️ Manutenção &amp; Reparo de Conexão" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12" />

                                    <Button Click="BtnComando_Click" Tag="ipconfig /flushdns" Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="12,8">
                                        <StackPanel>
                                            <TextBlock Text="🧹 Limpar Cache DNS (/flushdns)" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Text="Corrige falhas ao acessar sites e limpa histórico" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <Button Click="BtnComando_Click" Tag="ipconfig /displaydns" Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="12,8">
                                        <StackPanel>
                                            <TextBlock Text="📜 Exibir Cache DNS (/displaydns)" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Text="Lista todos os sites memorizados recentemente" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Comandos com Alerta de Risco / Notificação -->
                                    <Button Click="BtnRelease_Click" Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="12,8">
                                        <StackPanel>
                                            <TextBlock Text="⚠️ Liberar Endereço IP (/release)" FontWeight="Bold" Foreground="#F59E0B" />
                                            <TextBlock Text="Interrompe conexão temporariamente [Requer Alerta]" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <Button Click="BtnRenew_Click" Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="12,8">
                                        <StackPanel>
                                            <TextBlock Text="🔄 Solicitar Novo IP (/renew)" FontWeight="Bold" Foreground="{StaticResource AccentSecondaryBrush}" />
                                            <TextBlock Text="Reconecta e solicita novo IP via DHCP" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <Button Click="BtnRenovarCompleto_Click" Margin="0,0,0,0" HorizontalContentAlignment="Left" Padding="12,8">
                                        <StackPanel>
                                            <TextBlock Text="⚡ Reset Completo de Conexão (Release + Renew)" FontWeight="Bold" Foreground="#38BDF8" />
                                            <TextBlock Text="Libera e renova IP automaticamente com aviso" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- CARD 2: TESTE DE CONECTIVIDADE DIRETA -->
                        <Border Background="{StaticResource SurfaceDarkBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="🌐 Testes de Conectividade Direta (Ping &amp; Tracert)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,10" />

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="TxtHostRede" Text="google.com" PreviewMouseWheel="TextBox_BloquearScrollMouse" Margin="0,0,10,0" Height="36" />
                                    <Button Grid.Column="1" Click="BtnPing_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Height="36">
                                        <TextBlock Text="⚡ Testar Ping" />
                                    </Button>
                                    <Button Grid.Column="2" Click="BtnTracert_Click" Height="36">
                                        <TextBlock Text="🛤️ Rastrear Rota (Tracert)" />
                                    </Button>
                                </Grid>

                                <!-- Atalhos rápidos em chips -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Sugestões rápidas:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Button Content="google.com" Click="ChipHost_Click" Tag="google.com" Padding="8,3" FontSize="11" Margin="0,0,6,0" />
                                    <Button Content="1.1.1.1 (Cloudflare)" Click="ChipHost_Click" Tag="1.1.1.1" Padding="8,3" FontSize="11" Margin="0,0,6,0" />
                                    <Button Content="8.8.8.8 (Google)" Click="ChipHost_Click" Tag="8.8.8.8" Padding="8,3" FontSize="11" Margin="0,0,6,0" />
                                    <Button Content="192.168.1.1 (Roteador)" Click="ChipHost_Click" Tag="192.168.1.1" Padding="8,3" FontSize="11" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ================= ABA 2: WINGET / ATUALIZAÇÕES E INSTALAÇÃO ================= -->
                <ScrollViewer x:Name="PanelApps" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                    <StackPanel>
                        <!-- CARD 1: CENTRAL DE ATUALIZAÇÕES DO WINGET -->
                        <Border Background="{StaticResource SurfaceDarkBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="🔄 Central de Atualizações (Winget)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6" />
                                <TextBlock Text="Verifique quais programas possuem versões novas antes de atualizar." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Passo 1: Verificar (Sem instalar nada!) -->
                                    <Button Grid.Column="0" Click="BtnVerificarAtualizacoes_Click" Margin="0,0,6,0" Padding="14,10" HorizontalContentAlignment="Left">
                                        <StackPanel>
                                            <TextBlock Text="🔍 1. Verificar Atualizações Disponíveis" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Text="Apenas lista quais apps têm update (não instala nada)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Passo 2: Atualizar Todos (Com aviso de risco) -->
                                    <Button Grid.Column="1" Click="BtnUpgradeAll_Click" Margin="6,0,0,0" Padding="14,10" HorizontalContentAlignment="Left">
                                        <StackPanel>
                                            <TextBlock Text="🔄 2. Atualizar Todos os Apps do PC" FontWeight="Bold" Foreground="{StaticResource AccentSecondaryBrush}" />
                                            <TextBlock Text="Atualiza em lote silenciosamente com aviso prévio" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Atualizar App Específico -->
                                <Border Background="#16161B" CornerRadius="6" Padding="12,8" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Atualizar apenas um aplicativo:" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBox x:Name="TxtAppIdUpgrade" PreviewMouseWheel="TextBox_BloquearScrollMouse" Grid.Column="1" Text="Git.Git" Height="32" Margin="0,0,8,0" />
                                        <Button Grid.Column="2" Click="BtnUpgradeEspecifico_Click" Style="{StaticResource PrimaryButtonStyle}" Height="32" Padding="12,0">
                                            <TextBlock Text="⬆ Atualizar Este App" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- CARD 2: INSTALAÇÃO EM LOTE PÓS-FORMATAÇÃO -->
                        <Border Background="{StaticResource SurfaceDarkBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="🚀 Instalação Rápida Pós-Formatação" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                        <TextBlock Text="Marque os programas desejados para instalar em fila com um clique." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>

                                    <Button Grid.Column="1" Click="BtnMarcarTodos_Click" Content="Selecionar Todos" Margin="0,0,6,0" Padding="10,6" FontSize="11" />
                                    <Button Grid.Column="2" Click="BtnDesmarcarTodos_Click" Content="Desmarcar Todos" Margin="0,0,10,0" Padding="10,6" FontSize="11" />
                                    <Button Grid.Column="3" Click="BtnInstalarApps_Click" Style="{StaticResource PrimaryButtonStyle}" Height="36" Padding="14,0">
                                        <TextBlock Text="🚀 Instalar Selecionados" FontWeight="Bold" />
                                    </Button>
                                </Grid>

                                <!-- Colunas de Checkboxes -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- NAVEGADORES -->
                                    <Border Grid.Column="0" Background="#16161B" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="🌐 Navegadores" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8" />
                                            <CheckBox x:Name="AppChrome" Tag="Google.Chrome" Content="Google Chrome" IsChecked="True" />
                                            <CheckBox x:Name="AppBrave" Tag="BraveSoftware.BraveBrowser" Content="Brave Browser" />
                                            <CheckBox x:Name="AppFirefox" Tag="Mozilla.Firefox" Content="Mozilla Firefox" />
                                            <CheckBox x:Name="AppOperaGX" Tag="Opera.OperaGX" Content="Opera GX" />
                                        </StackPanel>
                                    </Border>

                                    <!-- MÍDIA & MENSAGENS -->
                                    <Border Grid.Column="2" Background="#16161B" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="🎮 Mídia &amp; Mensagens" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8" />
                                            <CheckBox x:Name="AppSpotify" Tag="Spotify.Spotify" Content="Spotify" IsChecked="True" />
                                            <CheckBox x:Name="AppDiscord" Tag="Discord.Discord" Content="Discord" />
                                            <CheckBox x:Name="AppVLC" Tag="VideoLAN.VLC" Content="VLC Player" IsChecked="True" />
                                            <CheckBox x:Name="AppSteam" Tag="Valve.Steam" Content="Steam" />
                                            <CheckBox x:Name="AppWhatsApp" Tag="WhatsApp.WhatsApp" Content="WhatsApp Desktop" />
                                        </StackPanel>
                                    </Border>

                                    <!-- DEV & UTILITÁRIOS -->
                                    <Border Grid.Column="4" Background="#16161B" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="💻 Ferramentas &amp; Dev" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8" />
                                            <CheckBox x:Name="AppVSCode" Tag="Microsoft.VisualStudioCode" Content="VS Code" IsChecked="True" />
                                            <CheckBox x:Name="AppGit" Tag="Git.Git" Content="Git for Windows" IsChecked="True" />
                                            <CheckBox x:Name="App7Zip" Tag="7zip.7zip" Content="7-Zip" IsChecked="True" />
                                            <CheckBox x:Name="AppNotepadPlusPlus" Tag="Notepad++.Notepad++" Content="Notepad++" />
                                            <CheckBox x:Name="AppDocker" Tag="Docker.DockerDesktop" Content="Docker Desktop" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- CARD 3: PESQUISAR QUALQUER PROGRAMA NO REPOSITÓRIO DO WINGET -->
                        <Border Background="{StaticResource SurfaceDarkBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="🔎 Pesquisar Qualquer Programa no Repositório do Winget" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6" />
                                <TextBlock Text="Procure e instale softwares que não estão na lista rápida (ex: obs, telegram, blender, visualstudio)." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtPesquisaWinget" PreviewMouseWheel="TextBox_BloquearScrollMouse" Text="obs-studio" Height="34" Margin="0,0,8,0" />
                                    <Button Grid.Column="1" Click="BtnBuscarWinget_Click" Style="{StaticResource PrimaryButtonStyle}" Height="34" Padding="14,0">
                                        <TextBlock Text="🔍 Buscar no Repositório" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ================= ABA 3: PASTAS E ARQUIVOS ================= -->
                <ScrollViewer x:Name="PanelPastas" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                    <StackPanel>
                        <Border Background="{StaticResource SurfaceDarkBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="📁 Gerenciamento de Pastas e Espaço em Disco" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12" />

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtCaminhoPasta" PreviewMouseWheel="TextBox_BloquearScrollMouse" Text="C:\MinhaNovaPasta" Margin="0,0,10,0" Height="36" />
                                    <Button Grid.Column="1" Click="BtnCriarPasta_Click" Style="{StaticResource PrimaryButtonStyle}" Height="36">
                                        <TextBlock Text="📁 Criar Pasta (mkdir)" />
                                    </Button>
                                </Grid>

                                <WrapPanel ItemWidth="280">
                                    <Button Click="BtnComando_Click" Tag="dir" Margin="0,0,10,10" HorizontalContentAlignment="Left" Padding="12,8">
                                        <StackPanel Margin="2">
                                            <TextBlock Text="dir" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Text="Lista arquivos e diretórios da pasta atual" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <!-- COMANDO ATUALIZADO: Substitui wmic pelo Get-Volume do Windows 11 -->
                                    <Button Click="BtnEspacoDisco_Click" Margin="0,0,10,10" HorizontalContentAlignment="Left" Padding="12,8">
                                        <StackPanel Margin="2">
                                            <TextBlock Text="📊 Espaço em Disco (Get-Volume)" FontWeight="Bold" Foreground="{StaticResource AccentSecondaryBrush}" />
                                            <TextBlock Text="Exibe tamanho e espaço livre em cada partição" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <!-- ABERTURA DIRETA DO EXPLORER -->
                                    <Button Click="BtnAbrirExplorer_Click" Margin="0,0,10,10" HorizontalContentAlignment="Left" Padding="12,8">
                                        <StackPanel Margin="2">
                                            <TextBlock Text="📂 Abrir no Explorer" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Text="Abre a pasta atual no Windows Explorer nativo" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ================= ABA 4: SISTEMA E REPARO (COM ALERTAS DE RISCO) ================= -->
                <ScrollViewer x:Name="PanelSistema" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                    <StackPanel>
                        <!-- CARD 1: DIAGNÓSTICO E REPARO PROFUNDO -->
                        <Border Background="{StaticResource SurfaceDarkBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="🛠️ Diagnóstico e Reparo do Windows (Com Alertas de Segurança)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12" />

                                <WrapPanel ItemWidth="280">
                                    <Button Click="BtnSfc_Click" Margin="0,0,10,10" HorizontalContentAlignment="Left" Padding="12,8">
                                        <StackPanel Margin="2">
                                            <TextBlock Text="⚠️ sfc /scannow [Requer Alerta]" FontWeight="Bold" Foreground="#F59E0B" />
                                            <TextBlock Text="Verifica e repara arquivos corrompidos (5-15 min)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <Button Click="BtnDism_Click" Margin="0,0,10,10" HorizontalContentAlignment="Left" Padding="12,8">
                                        <StackPanel Margin="2">
                                            <TextBlock Text="⚠️ DISM RestoreHealth [Requer Alerta]" FontWeight="Bold" Foreground="#F59E0B" />
                                            <TextBlock Text="Restaura imagem do Windows via Update (10-25 min)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <Button Click="BtnChkdsk_Click" Margin="0,0,10,10" HorizontalContentAlignment="Left" Padding="12,8">
                                        <StackPanel Margin="2">
                                            <TextBlock Text="🔍 Verificar Disco (chkdsk C:)" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Text="Verifica integridade do sistema de arquivos" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <Button Click="BtnComando_Click" Tag="systeminfo" Margin="0,0,10,10" HorizontalContentAlignment="Left" Padding="12,8">
                                        <StackPanel Margin="2">
                                            <TextBlock Text="💻 systeminfo" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Text="Especificações do PC, RAM, BIOS e versão OS" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <Button Click="BtnComando_Click" Tag="tasklist" Margin="0,0,10,10" HorizontalContentAlignment="Left" Padding="12,8">
                                        <StackPanel Margin="2">
                                            <TextBlock Text="📋 tasklist" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Text="Lista todos os processos ativos e consumo" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- CARD 2: ENERGIA E DESLIGAMENTO PROGRAMADO -->
                        <Border Background="{StaticResource SurfaceDarkBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                            <StackPanel>
                                <TextBlock Text="⚡ Controle de Energia e Desligamento Programado" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12" />

                                <WrapPanel ItemWidth="280">
                                    <Button Click="BtnDesligar1Hora_Click" Margin="0,0,10,10" HorizontalContentAlignment="Left" Padding="12,8">
                                        <StackPanel Margin="2">
                                            <TextBlock Text="⏰ Desligar em 1 Hora (shutdown /s /t 3600)" FontWeight="Bold" Foreground="#F87171" />
                                            <TextBlock Text="Programa o computador para desligar em 60 min" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <Button Click="BtnCancelarDesligamento_Click" Margin="0,0,10,10" HorizontalContentAlignment="Left" Padding="12,8">
                                        <StackPanel Margin="2">
                                            <TextBlock Text="🛑 Cancelar Desligamento (shutdown /a)" FontWeight="Bold" Foreground="{StaticResource AccentSecondaryBrush}" />
                                            <TextBlock Text="Cancela qualquer desligamento agendado" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- SEPARADOR VISUAL -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="{StaticResource BorderDarkBrush}" />

            <!-- LADO DIREITO: TERMINAL / CONSOLE AO VIVO -->
            <Border Grid.Column="2" Background="{StaticResource ConsoleBgBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Topo do Console -->
                    <Border Grid.Row="0" Background="#16161A" CornerRadius="8,8,0,0" Padding="12,10" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="ConsoleStatusDot" Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="TxtConsoleStatus" Text="Console do Windows (Pronto)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Click="BtnCopiarConsole_Click" Padding="8,4" FontSize="11" Margin="0,0,6,0">
                                    <TextBlock Text="📋 Copiar" />
                                </Button>
                                <Button Click="BtnLimparConsole_Click" Padding="8,4" FontSize="11">
                                    <TextBlock Text="🧹 Limpar" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Caixa do Terminal com Rolagem Estilizada -->
                    <TextBox x:Name="TxtConsoleOutput" 
                             Grid.Row="1"
                             Style="{StaticResource ConsoleTextBoxStyle}" />

                    <!-- Barra de Ações do Console -->
                    <Border Grid.Row="2" Background="#16161A" CornerRadius="0,0,8,8" Padding="12,8" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,1,0,0">
                        <Grid>
                            <TextBlock x:Name="TxtComandoAtual" Text="Nenhum comando em execução." FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                            <Button x:Name="BtnPararComando" Click="BtnPararComando_Click" Style="{StaticResource DangerButtonStyle}" HorizontalAlignment="Right" Padding="12,5" FontSize="11" IsEnabled="False">
                                <TextBlock Text="⏹ Cancelar Execução" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= 3. BARRA INFERIOR DE STATUS ================= -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceDarkBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,1,0,0" Padding="20,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Desenvolvido por " FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                <TextBlock FontSize="11" VerticalAlignment="Center">
                    <Hyperlink NavigateUri="https://www.jeanbraga.dev/" RequestNavigate="Hyperlink_RequestNavigate" Foreground="{StaticResource AccentBrush}" TextDecorations="None" Cursor="Hand">
                        <Run Text="Jean Braga" FontWeight="Bold" />
                    </Hyperlink>
                </TextBlock>
                <TextBlock FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0">
                    <Hyperlink NavigateUri="https://www.jeanbraga.dev/" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#6EE7B7" TextDecorations="None" Cursor="Hand">
                        <Run Text="https://www.jeanbraga.dev/ ↗" FontSize="11" />
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
